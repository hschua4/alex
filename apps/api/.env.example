DATABASE_URL=postgres://alex:alex@localhost:5434/alex
PORT=3000

# better-auth (ADR-0002). Generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-secret-change-me
# Public origin the app is served from; same origin for API + SPA (no CORS).
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed past better-auth's CSRF check (comma-separated). Prod is
# same-origin so this is empty; in dev the Vite server is a separate origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
