DATABASE_URL=postgres://alex:alex@localhost:5434/alex
PORT=3000

# better-auth (ADR-0002). Generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-secret-change-me
# Public origin the app is served from; same origin for API + SPA (no CORS).
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed past better-auth's CSRF check (comma-separated). Prod is
# same-origin so this is empty; in dev the Vite server is a separate origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Object storage for original uploads (ADR-0007). In dev these point at the MinIO
# service from docker-compose; in prod they are R2 creds and S3_ENDPOINT is the
# R2 endpoint (S3_FORCE_PATH_STYLE can be false there).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=alex
S3_SECRET_ACCESS_KEY=alexsecret
S3_BUCKET=alex-documents
S3_FORCE_PATH_STYLE=true

# Embeddings (CONTEXT §7). The model is pinned; the key is required — ingestion
# calls the real provider in dev. EMBEDDING_BASE_URL points at OpenRouter/OpenAI;
# leave EMBEDDING_MODEL default unless you know what you're changing.
OPENROUTER_API_KEY=sk-or-change-me
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small

# In-process ingestion worker concurrency (ADR-0006) — kept low so embedding
# can't starve chat latency on the shared box.
INGEST_CONCURRENCY=1
