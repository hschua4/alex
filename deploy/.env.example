# /srv/alex/.env — copy to .env on the VPS, `chmod 600`, owner deploy:deploy.
# Never commit the filled-in version (DEPLOYMENT.md #9: CI holds no prod secrets).

# --- Image tag pinned by the deploy workflow (written as sha-<short>) ---
ALEX_IMAGE_TAG=latest

# --- Shared Postgres (DEPLOYMENT.md §5.3) ---
# Host `postgres` is the infra stack's service name on the external `postgres`
# network. The password is ALEX_DB_PW from /srv/infra/.env.
DATABASE_URL=postgres://alex:REPLACE-ME@postgres:5432/alex

PORT=3000

# --- better-auth (ADR-0002) ---
# Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=REPLACE-ME-STRONG-RANDOM
# Public origin. SPA and API share it, so no CORS and no cross-subdomain cookie
# work is needed (unlike Resitly — DEPLOYMENT.md #23).
BETTER_AUTH_URL=https://alex.hschua.com
# Same-origin in prod, so no extra origins past better-auth's CSRF check.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Original uploads → Cloudflare R2 (ADR-0007) ---
# R2 requires an explicit endpoint; it is NOT left unset in prod. Use virtual
# host style (S3_FORCE_PATH_STYLE=false) and the pseudo-region `auto`.
S3_ENDPOINT=https://REPLACE-ME-ACCOUNT-ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE-ME
S3_SECRET_ACCESS_KEY=REPLACE-ME
S3_BUCKET=alex-documents
S3_FORCE_PATH_STYLE=false

# --- Models, all via one OpenRouter key (CONTEXT §7) ---
OPENROUTER_API_KEY=sk-or-REPLACE-ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Changing EMBEDDING_MODEL invalidates every stored embedding. Do not touch it
# without a full re-index.
EMBEDDING_MODEL=text-embedding-3-small
CONDENSE_MODEL=openai/gpt-4o-mini

# --- In-process ingestion worker (ADR-0006) ---
# Kept at 1 on the shared 2 vCPU box so embedding can't starve chat latency.
INGEST_CONCURRENCY=1
